generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  password String

  gatewayRequests GatewayRequest[]
  projects        Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GatewayRequest {
  id           String   @id @default(cuid())
  prompt       String
  response     String
  provider     String
  responseTime Int
  createdAt    DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Log {
  id           String   @id @default(cuid())
  level        String
  provider     String
  message      String
  responseTime Int
  timestamp    DateTime @default(now())
}

model Project {
  id          String  @id @default(cuid())
  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  apiKeys ApiKey[]
  providers Provider[]
  
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model ApiKey {
  id        String   @id @default(cuid())

  name      String
  keyHash   String
  prefix    String

  createdAt DateTime @default(now())

  revoked   Boolean  @default(false)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Provider {
  id        String   @id @default(cuid())

  name      String
  baseUrl   String
  priority  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}