generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id @default(cuid())
  name            String
  email           String           @unique
  password        String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  gatewayRequests GatewayRequest[]
  projects        Project[]
}

model GatewayRequest {
  id           String   @id @default(cuid())
  prompt       String
  response     String
  provider     String
  responseTime Int
  createdAt    DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User?   @relation(fields: [userId], references: [id])
  userId    String?
}

model Log {
  id           String   @id @default(cuid())
  level        String
  provider     String
  message      String
  responseTime Int
  timestamp    DateTime @default(now())
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String

  apiKeys         ApiKey[]
  providers       Provider[]
  gatewayRequests GatewayRequest[] // <-- add this

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id        String   @id @default(cuid())
  name      String
  keyHash   String
  prefix    String
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Provider {
  id       String  @id @default(cuid())
  name     String
  apiKey   String
  model    String
  baseUrl  String
  priority Int
  enabled  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
