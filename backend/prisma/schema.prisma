generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  password            String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  gatewayRequests     GatewayRequest[]
  projects            Project[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model GatewayRequest {
  id               String   @id @default(cuid())
  endpoint         String
  provider         String
  model            String?
  prompt           String
  response         String
  success          Boolean  @default(true)
  error            String?
  responseTime     Int
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  createdAt        DateTime @default(now())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?    @relation(fields: [userId], references: [id])
}

model Log {
  id           String   @id @default(cuid())
  level        String
  provider     String
  message      String
  responseTime Int
  timestamp    DateTime @default(now())
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String

  apiKeys         ApiKey[]
  providers       Provider[]
  gatewayRequests GatewayRequest[] // <-- add this

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id        String   @id @default(cuid())
  name      String
  keyHash   String
  prefix    String
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Provider {
  id       String  @id @default(cuid())
  name     String
  apiKey   String
  model    String
  baseUrl  String
  priority Int
  enabled  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model AsyncJob {
  id               String    @id @default(cuid())
  status           JobStatus @default(QUEUED)
  prompt           String
  provider         String?
  response         String?
  error            String?
  latency          Int?
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  projectId        String?
  createdAt        DateTime  @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  updatedAt        DateTime  @updatedAt
}
